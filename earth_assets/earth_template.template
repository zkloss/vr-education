<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VR 赋能教育 · 抗战历史沉浸式课堂</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#02050b;color:#e8edf4;font-family:"Segoe UI","Microsoft YaHei",sans-serif}canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:grab}canvas:active{cursor:grabbing}.shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(1,5,12,.6),transparent 48%),linear-gradient(0deg,rgba(1,5,12,.65),transparent 22%,transparent 88%,rgba(1,5,12,.25))}.brand{position:absolute;left:5vw;top:5vh;letter-spacing:.28em;font-size:11px;color:#bac9da;display:flex;gap:14px;align-items:center}.brand:before{content:"";width:21px;height:21px;border:1px solid #adc6e0;border-radius:50%;box-shadow:inset 0 0 8px #76b4ed30}.caption{position:absolute;left:6vw;top:38%;pointer-events:none;transition:opacity 1s,transform 1s}.eyebrow{color:#8eaecb;font-size:11px;letter-spacing:.28em;margin-bottom:20px}.caption h1{font-size:clamp(36px,4.2vw,70px);font-weight:300;letter-spacing:.18em;line-height:1.2;margin:0 0 22px}.caption p{font-size:13px;font-weight:300;letter-spacing:.12em;color:#a4b5c7;line-height:2;margin:0}.dest{opacity:0;transform:translateY(16px)}body.arrived .intro{opacity:0;transform:translateY(-15px)}body.arrived .dest{opacity:1;transform:none}.dest h1{font-size:clamp(44px,6.5vw,106px);letter-spacing:.22em}.dest .english{display:block;font-size:12px;letter-spacing:.65em;color:#c5d5e6;margin-top:24px}.bottom{position:absolute;bottom:5vh;left:5vw;right:5vw;display:flex;align-items:end;justify-content:space-between;gap:24px}.journey{width:260px;max-width:40vw}.phase{font-size:11px;letter-spacing:.18em;color:#b6c7d8;margin-bottom:12px}.track{height:1px;background:#ffffff25}.fill{width:0;height:1px;background:#b5d9fa;box-shadow:0 0 8px #86c5ff}.time{display:flex;justify-content:space-between;font-size:10px;color:#72859a;letter-spacing:.14em;margin-top:10px}.controls{display:flex;gap:8px;align-items:center}button{background:#0e182480;border:1px solid #b6d0e32d;color:#ccdbea;backdrop-filter:blur(12px);padding:11px 17px;border-radius:3px;cursor:pointer;font:11px "Microsoft YaHei",sans-serif;letter-spacing:.1em;transition:.2s}button:hover{background:#263c5099;border-color:#badcf07a}button:focus-visible{outline:2px solid #91caff;outline-offset:3px}.hint{font-size:10px;color:#8096ab;margin-right:12px;letter-spacing:.1em}.label{position:absolute;pointer-events:none;display:flex;align-items:center;gap:10px;opacity:0;transition:opacity 1s}.label i{display:block;width:7px;height:7px;background:#d0eeff;border-radius:50%;box-shadow:0 0 0 7px #9dd8ff19,0 0 24px #7ecbff}.label span{font-size:11px;letter-spacing:.18em;color:#e0f0fc;text-shadow:0 2px 8px #000}.status{position:absolute;inset:0;background:#02050b;display:flex;align-items:center;justify-content:center;font-size:14px;letter-spacing:.15em;z-index:10}.status:empty{display:none}.credit{position:absolute;right:5vw;top:5vh;font-size:9px;color:#677e95;letter-spacing:.15em}.clean .brand,.clean .caption,.clean .bottom,.clean .label,.clean .credit{opacity:0!important;pointer-events:none!important}.clean .shade{background:none}@media(max-width:700px){.caption{top:20%;left:7vw}.caption h1{font-size:38px}.hint{display:none}.controls{gap:5px}button{padding:10px}.journey{width:110px}.credit{display:none}.dest h1{font-size:52px}.caption p{font-size:11px}.bottom{bottom:4vh;align-items:center}.eyebrow{font-size:9px}}
</style></head><body>
<div id="status" class="status">正在准备沉浸式课堂…</div><div class="shade"></div>
<div class="brand">VR 赋能教育 / 抗战历史沉浸式课堂</div><div class="credit">EARTH TEXTURE · SOLAR SYSTEM SCOPE · CC BY 4.0</div>
<div class="caption intro"><div class="eyebrow">A JOURNEY HOME · 01</div><h1>越过山海</h1><p>从浩瀚太空出发<br>把目光，落在中国。</p></div>
<div class="caption dest"><div class="eyebrow">DESTINATION · 抵达</div><h1>中国<span class="english">C H I N A</span></h1><p>山河入眼，万里在场。</p></div>
<div class="label" id="label"><i></i><span>中国</span></div>
<div class="bottom"><div class="journey"><div class="phase" id="phase">01 / 太空启程</div><div class="track"><div class="fill" id="fill"></div></div><div class="time"><span id="elapsed">00:00</span><span>00:24</span></div></div><div class="controls"><span class="hint">拖动环视 · 滚轮缩放</span><button id="pause">暂停</button><button id="replay">重新漫游</button><button id="home">回到中国</button><button id="fullscreen" aria-label="全屏">全屏</button></div></div>
<script>__THREE__</script><script>
(()=>{'use strict';
const $=id=>document.getElementById(id),DURATION=24;
const state={time:0,playing:true,manual:false,lon:-78,lat:15,distance:5.4,arrived:false,loaded:false};window.earthTour=state;
let renderer;try{renderer=new THREE.WebGLRenderer({antialias:true,alpha:false,preserveDrawingBuffer:true});}catch(e){$('status').textContent='当前浏览器未能启用 3D 图形，请用 Edge 或 Chrome 打开。';return}
renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.setClearColor(0x02050b);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;document.body.prepend(renderer.domElement);
const scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(44,innerWidth/innerHeight,.01,200);
const pos=(lat,lon,r=1)=>{let a=THREE.MathUtils.degToRad(lat),b=THREE.MathUtils.degToRad(lon);return new THREE.Vector3(Math.cos(a)*Math.cos(b)*r,Math.sin(a)*r,-Math.cos(a)*Math.sin(b)*r)};
const loader=new THREE.TextureLoader();const tex=(uri,color)=>new Promise((res,rej)=>loader.load(uri,t=>{if(color)t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=Math.min(renderer.capabilities.getMaxAnisotropy(),8);res(t)},undefined,rej));
let earth,atmosphere;
Promise.all([tex('__EARTH__',true),tex('__NORMAL__'),tex('__SPECULAR__')]).then(([map,normalMap,specularMap])=>{
 earth=new THREE.Mesh(new THREE.SphereGeometry(1,128,96),new THREE.MeshPhongMaterial({map,normalMap,normalScale:new THREE.Vector2(.45,.45),specularMap,specular:new THREE.Color(0x5b7587),shininess:20}));scene.add(earth);
 atmosphere=new THREE.Mesh(new THREE.SphereGeometry(1.025,96,64),new THREE.ShaderMaterial({transparent:true,side:THREE.BackSide,depthWrite:false,blending:THREE.AdditiveBlending,uniforms:{glowColor:{value:new THREE.Color(0x287bd2)}},vertexShader:'varying vec3 vN;varying vec3 vV;void main(){vec4 p=modelViewMatrix*vec4(position,1.0);vN=normalize(normalMatrix*normal);vV=normalize(-p.xyz);gl_Position=projectionMatrix*p;}',fragmentShader:'varying vec3 vN;varying vec3 vV;uniform vec3 glowColor;void main(){float rim=pow(1.0-abs(dot(normalize(vN),normalize(vV))),3.8);gl_FragColor=vec4(glowColor,rim*.65);}'}));scene.add(atmosphere);
 state.loaded=true;$('status').textContent='';
}).catch(e=>{$('status').textContent='地球素材加载失败，请重新打开文件。';state.error=String(e)});
scene.add(new THREE.AmbientLight(0x779ac0,.55));const sun=new THREE.DirectionalLight(0xfff5e6,2.45);scene.add(sun);
let seed=20261111;const rand=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296};const points=[],colors=[];for(let i=0;i<2200;i++){let z=rand()*2-1,a=rand()*Math.PI*2,r=35+rand()*40,q=Math.sqrt(1-z*z);points.push(r*q*Math.cos(a),r*z,r*q*Math.sin(a));let c=.25+rand()*.55;colors.push(c*.8,c*.9,c)}const sg=new THREE.BufferGeometry();sg.setAttribute('position',new THREE.Float32BufferAttribute(points,3));sg.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));const stars=new THREE.Points(sg,new THREE.PointsMaterial({size:.045,vertexColors:true,transparent:true,opacity:.8,sizeAttenuation:true,depthWrite:false}));scene.add(stars);
const ease=t=>t*t*(3-2*t),mix=(a,b,t)=>a+(b-a)*t;
const keys=[{t:0,lon:-78,lat:15,d:5.4},{t:6,lon:-125,lat:8,d:4.1},{t:13,lon:-196,lat:24,d:3.4},{t:19,lon:-245,lat:37,d:2.65},{t:24,lon:-256,lat:35,d:2.02}];
function journey(t){let i=0;while(i<keys.length-2&&t>keys[i+1].t)i++;const a=keys[i],b=keys[i+1],span=b.t-a.t,u=THREE.MathUtils.clamp((t-a.t)/span,0,1);function sample(k){const prev=keys[Math.max(i-1,0)],next=keys[Math.min(i+2,keys.length-1)],m0=i===0?0:(b[k]-prev[k])/(b.t-prev.t),m1=i===keys.length-2?0:(next[k]-a[k])/(next.t-a.t);return (2*u*u*u-3*u*u+1)*a[k]+(u*u*u-2*u*u+u)*span*m0+(-2*u*u*u+3*u*u)*b[k]+(u*u*u-u*u)*span*m1}state.lon=sample('lon');state.lat=sample('lat');state.distance=sample('d')}
function ui(){let t=state.time;$('fill').style.width=Math.min(t/24*100,100)+'%';$('elapsed').textContent='00:'+String(Math.floor(t)).padStart(2,'0');$('phase').textContent=state.manual?'自由环视 / 地球':t<6?'01 / 太空启程':t<13?'02 / 越过太平洋':t<20?'03 / 飞向亚洲':'04 / 中国上空';$('pause').textContent=state.time>=24?'重播':state.playing?'暂停':'继续';document.body.classList.toggle('arrived',state.arrived)}
let homeMove=null;function home(){state.playing=false;state.manual=true;let target=-256;target+=Math.round((state.lon-target)/360)*360;homeMove={from:{lon:state.lon,lat:state.lat,d:state.distance},to:target,t:0};ui()}
function replay(){homeMove=null;state.time=0;state.playing=true;state.manual=false;state.arrived=false;ui()}
$('replay').onclick=replay;$('home').onclick=home;$('pause').onclick=()=>{if(state.manual){replay();return}if(state.time>=24){replay();return}state.playing=!state.playing;ui()};$('fullscreen').onclick=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.().catch(()=>{});else document.exitFullscreen?.()};
let drag=null;const el=renderer.domElement;el.addEventListener('pointerdown',e=>{if(e.button!==0)return;homeMove=null;drag={x:e.clientX,y:e.clientY,lon:state.lon,lat:state.lat};try{el.setPointerCapture(e.pointerId)}catch(e){};state.manual=true;state.playing=false;ui()});el.addEventListener('pointermove',e=>{if(!drag)return;state.lon=drag.lon-(e.clientX-drag.x)*.16;state.lat=THREE.MathUtils.clamp(drag.lat+(e.clientY-drag.y)*.13,-75,75)});function release(){drag=null}el.addEventListener('pointerup',release);el.addEventListener('pointercancel',release);el.addEventListener('lostpointercapture',release);window.addEventListener('blur',release);el.addEventListener('wheel',e=>{e.preventDefault();homeMove=null;state.manual=true;state.playing=false;state.distance=THREE.MathUtils.clamp(state.distance+e.deltaY*.0018,1.35,7);ui()},{passive:false});
document.addEventListener('keydown',e=>{if(e.target.tagName==='BUTTON')return;if(e.code==='Space'){e.preventDefault();$('pause').click()}if(e.key.toLowerCase()==='h')document.body.classList.toggle('clean');if(e.key==='Escape')document.body.classList.remove('clean')});
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
window.seekEarthTour=t=>{homeMove=null;state.time=THREE.MathUtils.clamp(t,0,24);state.manual=false;state.playing=false;journey(state.time);state.arrived=state.time>20;ui();draw(0)};
function draw(dt){if(!state.loaded)return;if(homeMove){homeMove.t=Math.min(homeMove.t+dt/2,1);let f=ease(homeMove.t);state.lon=mix(homeMove.from.lon,homeMove.to,f);state.lat=mix(homeMove.from.lat,35,f);state.distance=mix(homeMove.from.d,2.02,f);state.arrived=true;if(homeMove.t===1)homeMove=null;ui()}else if(!state.manual){if(state.playing){state.time=Math.min(state.time+dt,24);if(state.time>=24)state.playing=false}journey(state.time);state.arrived=state.time>20;ui()}
 camera.position.copy(pos(state.lat,state.lon,state.distance));camera.lookAt(0,0,0);
 // Shift the globe gently to the right while preserving the geographic landing point.
 const offset=innerWidth>900?.17:0;camera.setViewOffset(innerWidth,innerHeight,-innerWidth*offset,0,innerWidth,innerHeight);
 sun.position.copy(pos(state.lat+18,state.lon-35,10));renderer.render(scene,camera);
 const p=pos(35,104,1.008),visible=p.clone().normalize().dot(camera.position.clone().normalize())>1/state.distance;
 p.project(camera);$('label').style.left=((p.x*.5+.5)*innerWidth)+'px';$('label').style.top=((-p.y*.5+.5)*innerHeight)+'px';$('label').style.opacity=state.arrived&&visible&&Math.abs(p.x)<.95&&Math.abs(p.y)<.95?'1':'0';}
let last=performance.now();function loop(now){const dt=Math.min((now-last)/1000,.1);last=now;draw(document.hidden?0:dt);requestAnimationFrame(loop)}requestAnimationFrame(loop);ui();
})();</script></body></html>
